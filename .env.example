# Copy to .env. Compose reads it automatically; nothing here is secret
# except METRICS_TOKEN.

# Where the self-hosted Supabase compose lives. NOT in this repo, on
# purpose -- it is ChetanGk123/dokploy-templates, and its Postgres data
# directory lives beside it, so this path is also where your local
# database physically is. Keep it somewhere durable: a temp directory
# will be reaped and take the database with it.
SUPABASE_COMPOSE_DIR=../supabase-local/code

# Turns on GET /metrics. Prometheus needs the SAME value in
# monitoring/secrets/metrics_token -- it reads a file, not the
# environment, so this one secret has two homes. docs/development.md
# writes both from one openssl call.
METRICS_TOKEN=

# Both Supabase and the monitoring stack declare an external network.
# Pointing them at the same one means there is a single
# `docker network create` to remember.
MONITORING_API_NETWORK=dokploy-network

# Grafana admin password. Read only when Grafana first initialises its
# volume -- changing it later does nothing until `docker compose down -v`.
GRAFANA_PASSWORD=change-me
