# Copy to .env.local and adjust. Values here are safe defaults for local dev.
# Every variable must also be declared in src/lib/env.ts or it is ignored.

# Base URL. Used for metadataBase, so OG and canonical URLs resolve absolutely.
# Server-only and read at runtime, so deployments pass it per environment rather
# than baking it in. Prefix a variable `NEXT_PUBLIC_` only if the browser needs it.
APP_URL=http://localhost:3000

# Where apps/api is. Server-only, never NEXT_PUBLIC_ -- inside a container
# the address is http://api:3001, which means nothing to a browser.
API_URL=http://localhost:3001
