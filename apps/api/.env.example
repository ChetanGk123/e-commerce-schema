# Copy to .env and fill in. .env is gitignored.
# Every var here is required -- src/env.ts refuses to boot without it.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# INTERNAL address. On Dokploy this is http://kong:8000 over dokploy-network.
# NOT the public https://supabase.<domain> the browsers use for auth and
# realtime -- mixing the two produces failures that read like auth errors.
SUPABASE_URL=http://localhost:8000

# From the Dokploy template's generated .env (or Studio -> Project Settings).
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Self-hosted GoTrue signs HS256 with this shared secret -- confirmed from the
# template compose (GOTRUE_JWT_SECRET / PGRST_JWT_SECRET). Not JWKS.
SUPABASE_JWT_SECRET=replace-me

# Razorpay. Optional: without them the catalog, cart and COD checkout still
# work and /payments/* answers 503. KEY_ID reaches the browser; the other two
# must not.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Outbox delivery -- auth codes and order mail both leave through here.
#
# MAIL_PROVIDER picks the adapter. Leave it unset and it is inferred from
# whichever credentials are present, so an existing deployment is unaffected.
# With no provider configured the drain claims nothing and every message
# stays queued: deliberately the same shape as the provider being down.
#
#   resend  one HTTP call, no SMTP to configure
#   smtp    Gmail, Zoho, Fastmail, SES, Mailgun, Postmark, SendGrid --
#           they all speak SMTP, so this one adapter covers all of them
MAIL_PROVIDER=resend
MAIL_FROM=orders@example.com

# --- MAIL_PROVIDER=resend ---
RESEND_API_KEY=replace-me

# --- MAIL_PROVIDER=smtp ---
# Gmail: smtp.gmail.com:587, and SMTP_PASS must be an App Password
# (Google account -> Security -> 2-Step Verification -> App passwords).
# Your normal password will be refused.
# SMTP_SECURE=true is implicit TLS on 465. On 587 leave it false: the
# connection starts plaintext and upgrades with STARTTLS, which is still
# encrypted and is what Gmail, Zoho and SES expect.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-char-app-password
# Guards POST /jobs/drain. At least 16 characters.
JOBS_SECRET=replace-me-with-something-long
# Seconds between in-process drains; 0 turns the loop off.
JOBS_INTERVAL_SECONDS=60

# Browser origins allowed to call this API. Empty means none, which is the
# correct default for a service holding the service key.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Deadline on one call to Supabase (PostgREST or GoTrue). Neither
# supabase-js nor fetch imposes one, so without it a server that accepts
# the connection and stops answering holds the request open forever.
SUPABASE_TIMEOUT_MS=10000
# Ceiling on a whole request. Must exceed SUPABASE_TIMEOUT_MS -- the API
# refuses to boot otherwise. The per-call deadline does not bound a
# handler that makes several calls, and supabase-js retries a failed one
# up to four times by itself. POST /jobs/drain is exempt.
REQUEST_TIMEOUT_MS=30000
MAX_BODY_KB=256
# Whether /docs and /openapi.json answer at all. Public by default: the
# admin surface is guarded by requireStaff and RLS, not by being
# unlisted, and a document nobody can fetch is a client nobody can
# generate. false makes both 404. It protects nothing on its own -- if it
# feels like it does, fix the route it is hiding.
DOCS_PUBLIC=true
# Bearer token a Prometheus scraper presents at GET /metrics. Unset means
# the endpoint does not exist (404) -- it publishes the route table, the
# traffic shape and the state of the mail queue. Min 16 characters.
#   scrape_configs:
#     - job_name: ecom-api
#       authorization: { credentials: "<this value>" }
# METRICS_TOKEN=

# --- Product images -------------------------------------------------
# Supabase Storage bucket, backed by Cloudflare R2. Unset means the image
# routes answer 503 rather than pretending; the R2 credentials live on
# the storage container, not here. See docs/setup.md C5.
# STORAGE_BUCKET=product-images
# Custom domain on the R2 bucket. Unset, image URLs fall back to
# Supabase Storage's public path -- which works, and proxies every byte
# through your container at your expense. Set this before real traffic.
# STORAGE_PUBLIC_URL=https://images.example.com
# One megabyte, not five. The API buffers the whole upload in memory, so
# this times concurrency is resident bytes. Affordable because Cloudflare
# resizes at the edge (setup.md C5b) -- the stored original only has to be
# good enough to derive from.
MAX_IMAGE_KB=1024
# Advertise Cloudflare edge resizing on storefront images. Requires Image
# Resizing enabled on the zone AND STORAGE_PUBLIC_URL being a proxied
# custom domain. Off by default: a srcset the zone cannot serve is a
# broken page, which is worse than a heavy one.
IMAGE_RESIZE_CDN=false
# Per-IP requests per minute on anonymous write surfaces. 0 disables.
RATE_LIMIT_PER_MINUTE=60
# Only set this if something in front actually sets it, or callers can
# forge their own rate-limit bucket.
# TRUSTED_PROXY_HEADER=x-forwarded-for
