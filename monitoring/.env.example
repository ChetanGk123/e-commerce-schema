# Copy to .env before the first `docker compose up`. Compose reads .env
# from this directory automatically.
#
# THIS IS NOT OPTIONAL CONVENIENCE. The api network is `external: true`,
# so its name is resolved when a container is CREATED and then baked in.
# A single `docker compose up -d` without these set rebinds Prometheus to
# the default network, and the symptom is not "wrong network" -- it is
#
#   Get "http://api:3001/metrics": dial tcp: lookup api ... no such host
#
# which reads like DNS or a dead API. Keeping it in .env means every
# compose command in this directory gets it, including the ones you run
# six months from now without reading the README.

# The network the API container is on. `dokploy-network` on Dokploy.
MONITORING_API_NETWORK=dokploy-network

# Grafana admin password. There is no other authentication in front of
# this stack.
GRAFANA_PASSWORD=change-me

# Host port for Grafana. Not 3000 -- that is the admin app's.
GRAFANA_PORT=3030
